# ── Core ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
DATABASE_URL=postgres://lifted:lifted@127.0.0.1:5432/lifted

# ── Keys (dev only: generate with `openssl rand -base64 32`) ──────────
# In production these come from a KMS/HSM via the KeyProvider interface,
# never from env files. The vault key MUST differ from the data key.
DATA_MASTER_KEY=
VAULT_MASTER_KEY=
# HMAC secret for the bill-pay partner's signed webhooks.
BILLPAY_WEBHOOK_SECRET=

# ── Auth ─────────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Lifted
# One-click demo accounts. Refused at boot when NODE_ENV=production.
ALLOW_DEMO_LOGIN=true

# ── Payments ─────────────────────────────────────────────────────────
# "mock" simulates Stripe + the bill-pay partner locally. "stripe" is live.
PAYMENTS_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connected account (acct_...) of the licensed bill-pay partner.
STRIPE_BILLPAY_PARTNER_ACCOUNT=
PLATFORM_FEE_BPS=500

# ── Bill extraction ──────────────────────────────────────────────────
# "manual" = poster types fields. "anthropic" = Claude reads the bill.
# Only enable "anthropic" under a zero-data-retention agreement.
EXTRACTION_PROVIDER=manual
ANTHROPIC_API_KEY=
